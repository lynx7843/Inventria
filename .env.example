# Overrides for docker-compose.yml's dev-only defaults. Copy to .env (in this
# same directory - docker compose loads it automatically) and adjust; unset
# values keep the defaults baked into docker-compose.yml, which are fine for
# local use but must not be reused anywhere real accounts or data matter.

# Must satisfy SQL Server's complexity rules (8+ chars, 3 of: upper, lower,
# digit, symbol). Used by both the db and api services.
MSSQL_SA_PASSWORD=

# At least 32 bytes. Signs session tokens - see backend/Program.cs.
JWT_KEY=

# Left blank, both default to the demo password 'password' (logged once at
# API startup as a reminder) - see SeedAdminUser/SeedEmployeeUser in
# backend/Program.cs.
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=

# Encrypts the authenticator-app secrets behind two-factor sign-in. Unlike a
# password, a TOTP secret has to be readable back to check a code, so it is
# encrypted rather than hashed - this key is what a stolen database backup
# would still be missing. Blank means the app runs normally and accounts
# simply cannot turn two-factor on. Changing it makes every enrolled account
# fall back to its recovery codes.
TOTP_ENCRYPTION_KEY=

# The timezone this warehouse keeps its days in, e.g. Europe/London or
# America/New_York. Timestamps are always stored in UTC; this only decides
# where one day ends and the next begins, for figures like "received today".
# Blank means UTC. An unrecognised id stops the API starting rather than
# quietly reporting the wrong day - see backend/WarehouseClock.cs.
WAREHOUSE_TIMEZONE=
