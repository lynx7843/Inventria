# Base URL of the Inventria backend API, no trailing slash.
# Copy this file to .env and adjust, or set the variable in your host's
# environment. Defaults to http://localhost:5240 when unset.
#
# Must match the origin the backend actually listens on, scheme and port
# included - the browser cannot follow a redirect to a different origin on a
# credentialed API call. `dotnet run` (the http profile) serves the default
# below; `dotnet run --launch-profile https` also serves
# https://localhost:7149, so set that here if you want the frontend to talk to
# the HTTPS endpoint.
PUBLIC_API_BASE_URL=http://localhost:5240
